#!/bin/bash
set -e

# Docs-only commits (Markdown anywhere, or anything under docs/) need no build or tests. A staged Swift file, even
# under docs/, still goes through format.sh's license header check.
if [ -z "$(git diff --cached --name-only | grep -vE '(\.md$|^docs/)')" ] &&
    git diff --cached --quiet --diff-filter=d -- '*.swift'; then
    echo "📝 Docs-only commit; skipping format and tests."
    exit 0
fi

echo "🔍 Running pre-commit validation..."

# 1. Format staged Swift files incrementally with swift-format
if [ -x "./script/format.sh" ]; then
    ./script/format.sh --staged
fi

# 2. DESIGN.md ratchet: the plain ./test.sh runs it first; the selective run below does not, so it runs here.
./script/design_lint.sh

# 3. Run the test atoms that cover the staged files (script/changed_atoms.sh; the whole suite when the change
# reaches past Sources/ and Tests/). ./test.sh still skips the Swift runner when the same inputs already passed the
# plain run. The design lint and the Python self-checks stay in the plain run and CI.
# Git exports these to hooks; SwiftPM's dependency checkout in a fresh worktree then reads the wrong repository.
# Only the tests drop them: format.sh must stage into the index this commit uses (a temporary one for `commit -a`).
# NEWS_TEST_FORCE is dropped too: a suite that just passed is never run twice by the hook.
changed_atoms=$(script/changed_atoms.sh)
env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u NEWS_TEST_FORCE \
    TEST_CHANGED_ATOMS_OVERRIDE="$changed_atoms" ./test.sh --changed
echo "✅ All tests passed. Proceeding with commit."

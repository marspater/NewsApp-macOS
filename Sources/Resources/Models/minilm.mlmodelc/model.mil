            tensor<bool, [3]> input_141_squeeze_mask_0 = const()[name = tensor<string, []>("input_141_squeeze_mask_0"), val = tensor<bool, [3]>([false, true, false])];
            tensor<fp16, [?, 384]> input_141_cast = slice_by_index(begin = input_141_begin_0, end = input_141_end_0, end_mask = input_141_end_mask_0, squeeze_mask = input_141_squeeze_mask_0, x = hidden_states_cast);
            tensor<fp16, [384, 384]> model_pooler_dense_weight_to_fp16 = const()[name = tensor<string, []>("model_pooler_dense_weight_to_fp16"), val = tensor<fp16, [384, 384]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(45137280)))];
            tensor<fp16, [384]> model_pooler_dense_bias_to_fp16 = const()[name = tensor<string, []>("model_pooler_dense_bias_to_fp16"), val = tensor<fp16, [384]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(45432256)))];
            tensor<fp16, [?, 384]> input_cast = linear(bias = model_pooler_dense_bias_to_fp16, weight = model_pooler_dense_weight_to_fp16, x = input_141_cast);
            tensor<fp16, [?, 384]> var_546_cast = tanh(x = input_cast);
            tensor<string, []> var_546_cast_to_fp32_dtype_0 = const()[name = tensor<string, []>("op_546_cast_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [?, 384]> pooler_output = cast(dtype = var_546_cast_to_fp32_dtype_0, x = var_546_cast);
            tensor<fp32, [?, ?, 384]> last_hidden_state = cast(dtype = hidden_states_cast_to_fp32_dtype_0, x = hidden_states_cast);
        } -> (last_hidden_state, pooler_output);
}